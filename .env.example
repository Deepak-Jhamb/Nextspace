# Root Environment Variables Placeholder

# Server Config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Auth
MONGO_URI=mongodb://localhost:27017/nexushub
JWT_SECRET=your_jwt_secret_key_change_in_production
